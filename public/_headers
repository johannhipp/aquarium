# Response headers for Cloudflare Pages and Netlify (GitHub Pages ignores this file and sends max-age=600 for everything).
# Hashed build output and the content-hashed map files never change under their name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/stream/chunks.*
  Cache-Control: public, max-age=31536000, immutable
/stream/dir.*
  Cache-Control: public, max-age=31536000, immutable
# These keep their name across builds: always revalidate (a 304 costs one round trip).
/stream/manifest.json
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
